# backend/.env.example
# Copy this to .env and adjust values as needed

# ── Model Configuration ───────────────────────────────────────────────────────
# Path to custom fine-tuned weights. Leave as 'yolov8n' to auto-download base model.
# Example for custom weights: MODEL_PATH=../ml/weights/best.pt
MODEL_PATH=yolov8n

# ── Inference Defaults ────────────────────────────────────────────────────────
DEFAULT_CONFIDENCE_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45
DEFAULT_MAX_DETECTIONS=50

# ── Preprocessing ─────────────────────────────────────────────────────────────
CLAHE_CLIP_LIMIT=2.0
NADIR_EXCISION_FRACTION=0.05

# ── Server Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
